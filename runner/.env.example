# Same value as bot's BOT_RUNNER_SECRET
BOT_RUNNER_SECRET=<generate: openssl rand -hex 32>

# Bot callback endpoint (bot's VPS public URL)
CALLBACK_URL=https://vps.example.is/callback

# Delivery server public URL (same VPS as bot, or separate)
DELIVERY_HOST=https://vps.example.is

# Shared with delivery server — for token registration auth
DELIVERY_SECRET=<generate: openssl rand -hex 32>

# SFTP credentials for uploading to the delivery VPS
SFTP_HOST=vps.example.is
SFTP_USER=delivery
# Paste the PEM private key with newlines replaced by \n
SFTP_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
SFTP_BASE=/srv/delivery
