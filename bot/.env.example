# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Public HTTPS base URL of this VPS (no trailing slash)
WEBHOOK_HOST=https://vps.example.is

# 64-char random hex — shared with runner for mutual auth (both directions)
BOT_RUNNER_SECRET=<generate: openssl rand -hex 32>

# Cloud Run service URL (no trailing slash)
RUNNER_URL=https://runner-xxxx-ew.a.run.app
